# Python bytecode & test caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/

# Local diagnostic outputs, raw monitoring logs, internal & sanitized run data
# Only keep directory placeholder in Git; NEVER auto-track user diagnostic data
reports/*
!reports/.gitkeep
network_environment.json
network_environment.md

# User-specific targets, local overrides, environment variables & secrets
config/targets.json
config/*.local.json
config/*.user.json
.env
.env.*
*.pfx
*.p12
*.cer
*.crt
*.key
*.pem
*.kdbx

# Raw logs, packet captures, crash dumps, installer binaries & transient runtime flags
*.log
*.jsonl
*.pcap
*.pcapng
*.etl
*.dmp
*.tmp
*.bak
*.flag
*.exe
*.msi
*.part
downloads/
fubon_eplus/

# OS / Editor metadata
Thumbs.db
Desktop.ini
.DS_Store
.vscode/
.idea/
